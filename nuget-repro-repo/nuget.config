<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Wipe out any machine/user-level sources (including nuget.org) -->
    <clear />
    <!-- REPLACE-ME: your Nexus base URL, e.g. http://localhost:8081 for local
         testing, or an ngrok/tunnel HTTPS URL if Snyk's cloud needs to reach it
         directly (the DIRECT integration path).

         allowInsecureConnections="true" is required as of the .NET 10 SDK's
         "NuGet HTTPS Everywhere" enforcement, since this is plain HTTP. Drop
         that attribute once you're on a real HTTPS tunnel/endpoint. -->
    <add key="ContosoMain" value="http://REPLACE-ME:8081/repository/contoso-nuget-main/index.json" allowInsecureConnections="true" />
    <add key="ContosoInternal" value="http://REPLACE-ME:8081/repository/contoso-nuget-internal/index.json" allowInsecureConnections="true" />
  </packageSources>

  <!-- All packages route to the main feed EXCEPT the Internal.* prefix,
       which is only resolvable from the second feed. This mirrors the
       customer's split-feed setup. -->
  <packageSourceMapping>
    <packageSource key="ContosoMain">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ContosoInternal">
      <package pattern="Internal.*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Only needed if your Nexus hosted repos require authenticated reads.
       A fresh Nexus install allows anonymous read by default, in which case
       you can delete this block entirely. -->
  <packageSourceCredentials>
    <ContosoMain>
      <add key="Username" value="%NEXUS_USER%" />
      <add key="ClearTextPassword" value="%NEXUS_API_KEY%" />
    </ContosoMain>
    <ContosoInternal>
      <add key="Username" value="%NEXUS_USER%" />
      <add key="ClearTextPassword" value="%NEXUS_API_KEY%" />
    </ContosoInternal>
  </packageSourceCredentials>
</configuration>
