<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Internal.Contoso.Secrets</PackageId>
    <Version>1.0.0</Version>
    <Authors>Contoso Test</Authors>
    <Description>Test package that exists ONLY on the second (Internal) feed. Used to prove packageSourceMapping's "Internal.*" prefix rule is honored end to end.</Description>
    <!-- Deliberately NOT setting GeneratePackageOnBuild here: combined with an
         explicit `dotnet pack` call (which pack-and-push.sh does), it's a known
         dotnet SDK race condition that throws NU5026 "file to be packed was not
         found on disk". We only ever pack explicitly, so we don't need it. -->
  </PropertyGroup>

</Project>
